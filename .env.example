# ── slides/.env.local (deck interactivo + app del público) ───────────────
# Config web de Firebase (no es secreta; la protección son las reglas y App Check).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_SESSION_ID=devfest-sdq-2026

# ── demo/.env.local (Rumbo) ─────────────────────────────────────────────
# Respaldo en la nube cuando no hay Gemini Nano. Restringe la key por API y referrer.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# ── ambos ───────────────────────────────────────────────────────────────
VITE_SLIDES_URL=https://fluid-generative-ui-slides.web.app
VITE_DEMO_URL=https://fluid-generative-ui-demo.web.app
