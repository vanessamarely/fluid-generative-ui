# Sin estas variables todo corre en "modo local" (BroadcastChannel entre pestañas),
# ideal para ensayar sin internet. Con ellas, slides + público se sincronizan por Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcional: App Check (reCAPTCHA Enterprise) para proteger Firebase AI Logic
VITE_RECAPTCHA_SITE_KEY=

# Identificador de la sesión en vivo (permite reutilizar el proyecto en otras charlas)
VITE_SESSION_ID=devfest-sdq-2026

# Modelos en la nube (Firebase AI Logic → Gemini Developer API)
VITE_GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
VITE_SLIDES_URL=
VITE_DEMO_URL=
